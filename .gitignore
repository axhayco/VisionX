# Secrets and Environment Variables
.env
.env.local
.env.*
!.env.example

# Python Virtual Environment
.venv/
venv/
env/
ENV/

# Python caching and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# SQLite databases
*.db
*.db-journal
*.db-shm
*.db-wal

# Frontend dependencies and logs
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend build output
backend/app/static/*
!backend/app/static/.gitkeep

# IDEs and Editors settings (optional but recommended to keep clean)
.idea/
.project
.settings/
*.sublime-project
*.sublime-workspace
.vscode/launch.json
.vscode/tasks.json
